{
  "name": "astromotion",
  "version": "0.37.1",
  "description": "Astro integration for markdown-authored slide decks powered by Reveal.js, with a bit of Marp syntax",
  "license": "MIT",
  "author": "Ben Swift",
  "bin": {
    "astromotion-check": "./scripts/deck-check.mjs",
    "astromotion-pdf": "./scripts/deck-pdf.mjs",
    "astromotion-text": "./scripts/deck-text.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./components/*": "./components/*",
    "./pages/*": "./pages/*",
    "./theme/*": "./theme/*",
    "./src/*": "./src/*",
    "./video/*": "./video/*"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint && pnpm lint:css",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "lint:css": "stylelint 'theme/**/*.css' 'video/**/*.css' --allow-empty-input",
    "lint:css:fix": "stylelint 'theme/**/*.css' 'video/**/*.css' --allow-empty-input --fix",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@qrgrid/core": "^0.2.4",
    "linkedom": "^0.18.12",
    "perfect-freehand": "^1.2.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.2",
    "remark-stringify": "^11.0.0",
    "reveal.js": "^6.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@e18e/eslint-plugin": "^0.8.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "astro": "^7.4.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.14.0",
    "remark-directive": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@astrojs/mdx": "^7.0.0 || ^8.0.0",
    "astro": "^7.0.0",
    "puppeteer-core": ">=25"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
