---
import DeckHead from "./DeckHead.astro";
import "reveal.js/reveal.css";
import "../theme/base.css";
import "../theme/whiteboard.css";
import "../theme/clock.css";
import "../theme/help-hint.css";
import "../theme/print.css";
import "virtual:astromotion/theme";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** `listed: false` builds the deck at its URL for anyone with the link, but
   *  keeps it out of the indexes — emits `<meta name="robots" content="noindex">`
   *  and marks the page `data-pagefind-ignore="all"` so a site search skips it. */
  listed?: boolean;
}

const { title, description, image, listed = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <DeckHead title={title} description={description} image={image} listed={listed} />
  </head>
  <body data-pagefind-ignore={listed ? undefined : "all"}>
    <slot />
  </body>
</html>
