---
import { Font } from "astro:assets";
import { fontVariables } from "virtual:astromotion/fonts";
import { favicon, ogImage } from "virtual:astromotion/head";
import { absoluteUrl, withBase } from "../src/head-urls.ts";

interface Props {
  title: string;
  description?: string;
  image?: string;
  unlisted?: boolean;
}

const { title, description = "Slide deck", image, unlisted = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// A deck's own `image:` frontmatter beats the integration-wide default. With
// neither, the social-card tags are omitted rather than pointed at a file the
// consumer may never have created.
const social = image ?? ogImage;
const socialUrl = social ? absoluteUrl(social, Astro.site, Astro.url, baseUrl) : undefined;
const faviconHref = favicon ? withBase(favicon, baseUrl) : undefined;
// Only claim a MIME type we can actually infer; a hardcoded image/svg+xml is
// wrong for a .png or .ico favicon.
const faviconType = favicon?.endsWith(".svg") ? "image/svg+xml" : undefined;
---

{fontVariables.map((cssVariable) => <Font cssVariable={cssVariable} preload />)}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{unlisted && <meta name="robots" content="noindex" />}
<title>{title}</title>

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:type" content="website" />
{
  socialUrl && (
    <>
      <meta property="og:image" content={socialUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}

<meta name="twitter:card" content={socialUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialUrl && <meta name="twitter:image" content={socialUrl} />}

{faviconHref && <link rel="icon" type={faviconType} href={faviconHref} />}

{/*
  Export mode. `astromotion-pdf` loads the deck with `?astromotion-export`,
  because decktape's generic plugin decides the deck is over when a
  MutationObserver over the whole document sees nothing change for a second
  after ArrowRight --- so a widget that redraws on a `setInterval` (a talk
  timer, a countdown, a marquee) means the export NEVER ends, and runs to
  DECKTAPE_MAX_SLIDES appending hundreds of copies of the final slide.

  Neutering `setInterval` leaves such a widget showing whatever it rendered on
  its first pass and then quiet, which is what a still frame of a deck should
  look like anyway. `setTimeout` is untouched: Reveal and Astro both use it for
  one-shot work during startup. Consumers needing more than a frozen widget can
  branch on the `data-astromotion-export` attribute this sets.

  Inline and in the head so it runs at parse time, ahead of the deferred module
  scripts that hydrate components.
*/}
<script is:inline>
  if (new URLSearchParams(location.search).has("astromotion-export")) {
    document.documentElement.dataset.astromotionExport = "";
    window.setInterval = () => 0;
  }
</script>
